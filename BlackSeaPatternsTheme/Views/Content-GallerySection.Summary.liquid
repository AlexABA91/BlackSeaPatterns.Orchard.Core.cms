<section id="gallery" class="slider-section section">
    <h2 class="gallery-title">{{Model.ContentItem.Content.TitlePart.Title}}</h2>

    <div class="gallery-filters-container">
        <!-- Десктопная и мобильная навигация -->
        <div class="gallery-year-tabs-wrapper">
            
           
            <div class="gallery-year-tabs" id="yearTabs">
                
                {% for item in Model.ContentItem.Content.BagPart.ContentItems %}
                   <button class="gallery-year-tab {% if forloop.first %} active {%  endif %}" data-year="{{ item.DisplayText }}"> 
                    
                        {{ item.DisplayText  }}
                    </button>
                {% endfor %}
             </div>
            <!-- Кнопка выпадающего списка для мобилок (будет видна только на узких экранах) -->
            <button class="gallery-mobile-tabs-dropdown-btn" id="mobileTabsBtn" aria-label="Toggle year selection">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>

            <!-- Выпадающее меню для мобилок -->
            <div class="gallery-mobile-dropdown" id="mobileDropdown"></div>
        </div>
    </div>
   
    <div class="gallery-grid-container" id="galleryGrid">
        {% for item in Model.ContentItem.Content.BagPart.ContentItems %}
             <div class="gallery-grid {% if forloop.first %}active{% endif %}"
         data-year="{{ item.DisplayText }}">
                  {% for photoPath in item.GalleryYear.Photos.Paths %}
                       <div class="gallery-item">
                            <img src="{{ photoPath | asset_url }}" class="gallery-image"
                                alt="{{ item.DisplayText }}" />
                       </div>
                   {% endfor %}
               </div>
        {% endfor %}
    </div>
</section>
{% script src:"~/BlackSeaPatternsTheme/Assets/js/galleryTabsScript.js", at:"Foot" %}